{
  "name": "demonx-forge",
  "version": "0.1.0",
  "private": true,
  "license": "GPL-3.0-or-later",
  "description": "DemonX Forge: a Fusion-style parametric 3D CAD application that runs locally",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w web",
    "start": "npm run start -w server",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
