+#[test]
+fn create_sketch_dropdown_waits_for_an_explicit_plane_choice() {
+    let mut h = Harness::new();
+    h.app.ui.show_origin = true;
+    h.app.session.visibility.hidden_origin = vec!["XY".into(), "XZ".into(), "YZ".into()];
+    h.app.start("sketch.create");
+    h.frames(4);
+    assert!(matches!(h.app.dialog.as_ref().map(|d| &d.kind), Some(Kind::Sketch)), "the picker stays open before a choice");
+    h.step(&json!({"click":{"handle":"dialog:origin-plane:dropdown"}})).unwrap();
+    h.frames(2);
+    h.step(&json!({"click":{"handle":"dialog:Origin plane:XZ · Front"}})).unwrap();
+    h.frames(4);
+    let id = h.app.session.active_sketch.expect("choosing a plane starts the sketch");
+    let actual = h.app.session.world_state().sketch(id).unwrap().plane.normal();
+    let expected = solidcraft_engine::geom::Plane::named("XZ").unwrap().normal();
+    assert!(actual.dot(expected).abs() > 1.0 - 1e-9, "Front selects the XZ plane: {actual:?}");
+}
