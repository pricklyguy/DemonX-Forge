+#[test]
+fn move_copy_drag_builds_a_visible_preview_without_changing_the_design() {
+    use crate::gizmo::{Change, Drag, Handle};
+    use solidcraft_engine::{Sel, geom::Vec3};
+
+    let mut h = crate::scenario::Harness::new();
+    h.app.run("solid.box", json!({"length":10,"width":10,"height":10})).unwrap();
+    let original = serde_json::to_value(&*h.app.session.doc).unwrap();
+    let undo = h.app.session.undo.len();
+    let mut dialog = crate::dialogs::Dialog::for_command(&h.app, "solid.move").unwrap();
+    dialog.inputs[0].items = vec![Sel::Body { name: "Body1".into() }];
+    dialog.extra.insert("copy".into(), json!(true));
+    crate::dialogs_move::drag(
+        &h.app,
+        &mut dialog,
+        Drag { handle: Handle::Axis(0), change: Change::Translate(Vec3::new(25.0, 0.0, 0.0)), started: true, done: false },
+    );
+    let commands = crate::dialogs::preview_commands(&h.app, &dialog).unwrap();
+    let built = compute(&h.app.session, &commands, colors()).unwrap();
+    assert!(built.bounds.max.x >= 35.0 - 1e-6, "the copied body should follow the dragged 25 mm offset: {:?}", built.bounds);
+    assert!(!built.scene.tris.is_empty(), "the dragged copy must have visible preview geometry");
+    assert_eq!(serde_json::to_value(&*h.app.session.doc).unwrap(), original, "preview must leave the saved design unchanged");
+    assert_eq!(h.app.session.undo.len(), undo, "preview must not append a history feature");
+}
