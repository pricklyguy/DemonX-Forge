+/// Show the exact length beside each selected model edge, without opening the Measure dialog.
+fn selected_edge_measurements(app: &SolveApp, ui: &mut egui::Ui, proj: &Proj) {
+    let state = app.session.world_state();
+    for (slot, selection) in app.session.selection.iter().enumerate() {
+        let Sel::Edge { body, point, .. } = selection else { continue };
+        let Some(model_body) = state.body(body) else { continue };
+        let tolerance = (model_body.body.size() * 2e-3).max(1e-3);
+        let Ok(edges) = model_body.body.edges(tolerance) else { continue };
+        let Some(edge) = edges.iter().min_by(|a, b| a.mid.dist(*point).total_cmp(&b.mid.dist(*point))) else { continue };
+        let Some(at) = proj.to_screen(edge.mid) else { continue };
+        let mut length = format!("{:.3}", edge.length);
+        while length.contains('.') && length.ends_with('0') {
+            length.pop();
+        }
+        if length.ends_with('.') {
+            length.pop();
+        }
+        let text = format!("{}  {} mm", crate::i18n::tr_label("Length"), length);
+        egui::Area::new(egui::Id::new(("sc_selected_edge_measurement", slot))).fixed_pos(at + vec2(12.0, -22.0)).order(egui::Order::Foreground).show(
+            ui.ctx(),
+            |ui| {
+                Container::popup_frame(ui.style()).inner_margin(egui::Margin::symmetric(7, 4)).show(ui, |ui| {
+                    ui.label(egui::RichText::new(&text).color(Tokens::get().text));
+                });
+            },
+        );
+    }
+}
