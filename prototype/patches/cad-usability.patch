+use egui::{Pos2, Rect, Vec2 as EguiVec2, pos2};
+use serde_json::json;
+use solidcraft_engine::sketch::ConstraintKind;
+
+fn snapped_at(h: &mut crate::scenario::Harness, point: [f64; 2]) -> (solidcraft_engine::geom::Vec2, Option<String>) {
+    let screen = h.at(&json!({"sketch": point})).unwrap();
+    let rect = h.app.viewport.rect.unwrap_or_else(|| Rect::from_min_size(Pos2::ZERO, EguiVec2::new(1600.0, 1000.0)));
+    let proj = crate::viewport::projection(&h.app, rect);
+    crate::viewport::sketch_point_at(&h.app, &proj, pos2(screen[0] as f32, screen[1] as f32)).unwrap()
+}
+
+#[test]
+fn drawing_endpoint_snaps_to_a_line_midpoint_and_keeps_the_constraint() {
+    let mut h = crate::scenario::Harness::new();
+    h.app.run("sketch.create", json!({"plane":"XY"})).unwrap();
+    h.app.run("sketch.line", json!({"points":[[0,0],[20,0]],"ids":["base"]})).unwrap();
+    h.step(&json!({"start":"sketch.line"})).unwrap();
+    let start = snapped_at(&mut h, [10.1, 0.1]);
+    assert_eq!(start.1.as_deref(), Some("mid:base"));
+    h.app.run("sketch.line", json!({"points":[start.1.unwrap(),[10,10]],"ids":["from_mid"]})).unwrap();
+    let sketch = h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.clone();
+    let endpoint = sketch.resolve_point("from_mid.start").unwrap();
+    assert!(
+        sketch.constraints.iter().any(
+            |constraint| matches!(constraint.kind, ConstraintKind::Midpoint { p, l } if p == endpoint && l == sketch.curve_index("base").unwrap())
+        )
+    );
+}
+
+#[test]
+fn drawing_endpoint_snaps_to_curve_intersection_and_stays_on_both_curves() {
+    let mut h = crate::scenario::Harness::new();
+    h.app.run("sketch.create", json!({"plane":"XY"})).unwrap();
+    h.app.run("sketch.line", json!({"points":[[32,0],[50,18]],"ids":["rise"]})).unwrap();
+    h.app.run("sketch.line", json!({"points":[[30,22],[52,0]],"ids":["fall"]})).unwrap();
+    h.step(&json!({"start":"sketch.line"})).unwrap();
+    let start = snapped_at(&mut h, [42.1, 10.1]);
+    assert!((start.0.dist(solidcraft_engine::geom::Vec2::new(42.0, 10.0))) < 1e-9);
+    let reference = start.1.expect("crossing should carry both curve references");
+    assert!(reference.starts_with("intersection:rise:fall:"), "wrong snap reference: {reference:?}");
+    h.app.run("sketch.line", json!({"points":[reference,[55,10]],"ids":["from_crossing"]})).unwrap();
+    let sketch = h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.clone();
+    let endpoint = sketch.resolve_point("from_crossing.start").unwrap();
+    let constrained: Vec<_> = sketch
+        .constraints
+        .iter()
+        .filter_map(|constraint| match constraint.kind {
+            ConstraintKind::PointOnCurve { p, c } if p == endpoint => Some(sketch.curves[c].id.as_str()),
+            _ => None,
+        })
+        .collect();
+    assert!(
+        constrained.contains(&"rise") && constrained.contains(&"fall"),
+        "intersection endpoint should follow both source curves: {constrained:?}"
+    );
+}
