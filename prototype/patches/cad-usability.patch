@@ -0,0 +1,14 @@
+use serde_json::json;
+use solidcraft_engine::{Sel, geom::Vec3};
+
+#[test]
+fn selecting_a_solid_edge_shows_its_exact_length_in_the_viewport() {
+    let mut h = crate::scenario::Harness::new();
+    h.app.run("solid.box", json!({"length":20,"width":10,"height":5})).unwrap();
+    let reply = h.app.run("model.edges", json!({"body":"Body1"})).unwrap();
+    let edge = reply["edges"].as_array().unwrap().iter().find(|edge| (edge["length"].as_f64().unwrap() - 20.0).abs() < 1e-9).unwrap();
+    let mid: Vec3 = serde_json::from_value(edge["mid"].clone()).unwrap();
+    h.app.session.selection = vec![Sel::Edge { body: "Body1".into(), index: edge["index"].as_u64().unwrap() as usize, point: mid }];
+    h.frames(3);
+    assert!(h.widget("Length  20 mm").is_some(), "the selected edge length should be visible as a viewport label");
+}
