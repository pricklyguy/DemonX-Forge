+#[test]
+fn mouse_drag_line_accepts_length_and_angle_and_escape_cancels_a_following_draw() {
+    use solidcraft_engine::sketch::CurveKind;
+    let (mut h, end) = mouse_draw("sketch.line", [0.0, 0.0], [24.0, 12.0]);
+    mouse_draw_release(&mut h, end);
+    type_value(&mut h, "20");
+    tab(&mut h, false);
+    assert_focus(&h, 1);
+    type_value(&mut h, "30 deg");
+    h.step(&json!({"key":"Enter"})).unwrap();
+    let sketch = h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.clone();
+    let (a, b) = sketch.curves.iter().find_map(|curve| match curve.kind { CurveKind::Line { a, b } => Some((a, b)), _ => None }).unwrap();
+    let line = sketch.point(b).unwrap() - sketch.point(a).unwrap();
+    assert!((line.len() - 20.0).abs() < 1e-6);
+    assert!((line.angle() - 30f64.to_radians()).abs() < 1e-6);
+
+    let before_cancel = h.app.session.doc.to_json();
+    let undo = h.app.session.undo.len();
+    h.step(&json!({"start":"sketch.rectangle.two_point"})).unwrap();
+    let start = h.at(&json!({"sketch":[40.0,0.0]})).unwrap();
+    let next = h.at(&json!({"sketch":[60.0,10.0]})).unwrap();
+    let (start, next) = (egui::pos2(start[0] as f32, start[1] as f32), egui::pos2(next[0] as f32, next[1] as f32));
+    use egui::Event;
+    h.app.synthetic.push(Event::PointerMoved(start));
+    h.app.synthetic.push(Event::PointerButton { pos:start, button:egui::PointerButton::Primary, pressed:true, modifiers:Default::default() });
+    for step in 1..=8 { h.app.synthetic.push(Event::PointerMoved(start + (next - start) * (step as f32 / 8.0))); }
+    crate::test_support::play(&mut h);
+    assert!(h.app.viewport.draw_drag.is_some());
+    h.step(&json!({"key":"A","cmd":true})).unwrap();
+    h.step(&json!({"text":"7"})).unwrap();
+    h.step(&json!({"key":"Escape"})).unwrap();
+    h.app.synthetic.push(Event::PointerMoved(next));
+    h.app.synthetic.push(Event::PointerButton { pos:next, button:egui::PointerButton::Primary, pressed:false, modifiers:Default::default() });
+    crate::test_support::play(&mut h);
+    let sketch = h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.clone();
+    assert_eq!(sketch.curves.len(), 1, "Escape must not leave a partial shape");
+    assert_eq!(h.app.session.doc.to_json(), before_cancel, "cancel preserves the existing sketch exactly");
+    assert_eq!(h.app.session.undo.len(), undo, "cancelling an in-progress drag changes no history");
+    assert!(h.app.tool.as_ref().is_some_and(|tool| tool.pts.is_empty()), "Escape clears staged geometry before the tool is reused");
+}
+#[test]
+fn mouse_drag_line_with_midpoint_snap_accepts_length_and_angle() {
+    use egui::Event;
+    use solidcraft_engine::sketch::ConstraintKind;
+
+    let mut h = Harness::new();
+    h.app.run("sketch.create", json!({"plane":"XY"})).unwrap();
+    h.app.run("sketch.line", json!({"points":[[0,0],[20,0]],"ids":["base"]})).unwrap();
+    h.step(&json!({"start":"sketch.line"})).unwrap();
+    let start = h.at(&json!({"sketch":[10.1,0.1]})).unwrap();
+    let end = h.at(&json!({"sketch":[10,8]})).unwrap();
+    let (start, end) = (egui::pos2(start[0] as f32, start[1] as f32), egui::pos2(end[0] as f32, end[1] as f32));
+    h.app.synthetic.push(Event::PointerMoved(start));
+    h.app.synthetic.push(Event::PointerButton { pos: start, button: egui::PointerButton::Primary, pressed: true, modifiers: Default::default() });
+    for step in 1..=8 {
+        h.app.synthetic.push(Event::PointerMoved(start + (end - start) * (step as f32 / 8.0)));
+    }
+    crate::test_support::play(&mut h);
+    h.app.synthetic.push(Event::PointerMoved(end));
+    h.app.synthetic.push(Event::PointerButton { pos: end, button: egui::PointerButton::Primary, pressed: false, modifiers: Default::default() });
+    crate::test_support::play(&mut h);
+    type_value(&mut h, "8");
+    tab(&mut h, false);
+    type_value(&mut h, "30 deg");
+    h.step(&json!({"key":"Enter"})).unwrap();
+
+    let sketch = h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.clone();
+    assert_eq!(sketch.curves.len(), 2, "the dimensioned segment must commit");
+    assert!(
+        sketch.constraints.iter().any(|constraint| matches!(constraint.kind, ConstraintKind::Midpoint { .. })),
+        "the start must retain its midpoint inference"
+    );
+    let dimensioned = sketch.constraints.iter().filter_map(|constraint| constraint.kind.value()).collect::<Vec<_>>();
+    assert!(dimensioned.iter().any(|value| (*value - 8.0).abs() < 1e-6), "length must remain a driving dimension: {dimensioned:?}");
+    assert!(dimensioned.iter().any(|value| (*value - 30f64.to_radians()).abs() < 1e-6), "angle must remain a driving dimension: {dimensioned:?}");
+}
