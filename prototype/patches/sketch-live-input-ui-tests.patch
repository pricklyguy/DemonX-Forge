+/// Exercise the ordinary viewport press/drag/release route while inline dimensions own focus.
+fn mouse_draw(command: &str, start: [f64; 2], end: [f64; 2]) -> (Harness, egui::Pos2) {
+    use egui::Event;
+    let mut h = Harness::new();
+    h.app.run("sketch.create", json!({"plane":"XY"})).unwrap();
+    h.app.cam.distance = 120.0;
+    h.settle();
+    h.step(&json!({"start":command})).unwrap();
+    let [ax, ay] = h.at(&json!({"sketch":start})).unwrap();
+    let [bx, by] = h.at(&json!({"sketch":end})).unwrap();
+    let (a, b) = (egui::pos2(ax as f32, ay as f32), egui::pos2(bx as f32, by as f32));
+    h.app.synthetic.push(Event::PointerMoved(a));
+    h.app.synthetic.push(Event::PointerButton { pos:a, button:egui::PointerButton::Primary, pressed:true, modifiers:Default::default() });
+    for step in 1..=8 {
+        h.app.synthetic.push(Event::PointerMoved(a + (b - a) * (step as f32 / 8.0)));
+    }
+    crate::test_support::play(&mut h);
+    assert!(h.app.viewport.draw_drag.is_some(), "the sketch tool owns the active pointer drag");
+    assert_eq!(h.app.tool.as_ref().unwrap().pts.len(), 1, "only the press point is placed before release");
+    assert_eq!(h.ctx.memory(|memory| memory.focused()), Some(egui::Id::new(("sc_dim", 0))), "the first live dimension takes focus during the drag");
+    (h, b)
+}
+
+fn mouse_draw_release(h: &mut Harness, end: egui::Pos2) {
+    use egui::Event;
+    h.app.synthetic.push(Event::PointerMoved(end));
+    h.app.synthetic.push(Event::PointerButton { pos:end, button:egui::PointerButton::Primary, pressed:false, modifiers:Default::default() });
+    crate::test_support::play(h);
+}
+
+#[test]
+fn mouse_drag_rectangle_accepts_exact_live_dimensions_and_undoes_as_one_shape() {
+    let (mut h, end) = mouse_draw("sketch.rectangle.two_point", [0.0, 0.0], [30.0, 15.0]);
+    mouse_draw_release(&mut h, end);
+    assert_eq!(h.app.tool.as_ref().unwrap().pts.len(), 1, "release leaves the second corner as an editable preview");
+    assert!(h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.curves.is_empty());
+    // Type after release; Tab stays in the live dimension fields until Enter confirms.
+    type_value(&mut h, "24");
+    tab(&mut h, false);
+    assert_focus(&h, 1);
+    type_value(&mut h, "12");
+    let undo = h.app.session.undo.len();
+    h.step(&json!({"key":"Enter"})).unwrap();
+    let sketch = h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.clone();
+    let profiles = solidcraft_engine::sketch::find_drawn_profiles(&sketch);
+    assert_eq!(profiles.len(), 1);
+    assert!((profiles[0].area - 288.0).abs() < 1e-6, "typed width × height must determine the profile area");
+    let driving_values: Vec<_> = sketch.constraints.iter().filter(|constraint| constraint.param.is_some()).filter_map(|constraint| constraint.kind.value()).collect();
+    assert!(driving_values.iter().any(|value| (value - 24.0).abs() < 1e-6), "the typed width remains a driving sketch dimension: {driving_values:?}");
+    assert!(driving_values.iter().any(|value| (value - 12.0).abs() < 1e-6), "the typed height remains a driving sketch dimension: {driving_values:?}");
+    h.frames(2);
+    assert_eq!(crate::dim_view::drawn().len(), 2, "width and height labels remain visible after confirming the rectangle");
+    assert_eq!(h.app.session.undo.len(), undo + 1, "the mouse gesture and dimensions form one undo step");
+    h.app.run("edit.undo", json!({})).unwrap();
+    assert!(h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.curves.is_empty());
+    h.app.run("edit.redo", json!({})).unwrap();
+    let sketch = h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.clone();
+    let profiles = solidcraft_engine::sketch::find_drawn_profiles(&sketch);
+    assert!((profiles[0].area - 288.0).abs() < 1e-6);
+}
