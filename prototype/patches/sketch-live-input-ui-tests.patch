+#[test]
+fn mouse_drag_circle_accepts_an_exact_diameter_without_a_dimension_tool() {
+    let (mut h, end) = mouse_draw("sketch.circle.center", [0.0, 0.0], [18.0, 6.0]);
+    mouse_draw_release(&mut h, end);
+    type_value(&mut h, "12 mm");
+    h.step(&json!({"key":"Enter"})).unwrap();
+    let sketch = h.app.session.world_state().sketch(h.app.session.active_sketch.unwrap()).unwrap().sketch.clone();
+    let profiles = solidcraft_engine::sketch::find_drawn_profiles(&sketch);
+    assert_eq!(profiles.len(), 1);
+    assert!((profiles[0].area - std::f64::consts::PI * 36.0).abs() < 1e-6, "the live diameter controls the drawn circle");
+}
